{
  "name": "@acp/core",
  "version": "0.1.0",
  "description": "Core identifiers, events, and transport-neutral primitives for Agent Communication Protocol implementations",
  "keywords": [
    "agent-communication-protocol",
    "acp",
    "events",
    "event-bus",
    "identifiers"
  ],
  "homepage": "https://github.com/frontal-labs/acp#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/acp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/acp.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "ultracite fix src",
    "lint": "ultracite check src",
    "test": "vitest run --root ../.. packages/core/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
