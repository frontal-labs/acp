{
  "name": "@frontal-labs/open-channel-runtime",
  "version": "0.1.0",
  "description": "OpenChannel Protocol runtime orchestration for requests, approvals, escalation, and audit events",
  "keywords": [
    "openchannel-protocol",
    "ocp",
    "runtime",
    "approvals",
    "escalation",
    "audit"
  ],
  "homepage": "https://github.com/frontal-labs/open-channel#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/open-channel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/open-channel.git",
    "directory": "packages/runtime"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "ultracite fix src",
    "lint": "ultracite check src",
    "test": "vitest run --root ../.. packages/runtime/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.5",
    "@frontal-labs/open-channel-adapter": "workspace:*",
    "@frontal-labs/open-channel-core": "workspace:*",
    "@frontal-labs/open-channel-policy": "workspace:*",
    "@frontal-labs/open-channel-protocol": "workspace:*"
  },
  "devDependencies": {
    "@frontal-labs/open-channel-testing": "workspace:*",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
