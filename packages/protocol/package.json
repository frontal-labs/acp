{
  "name": "@acp/protocol",
  "version": "0.1.0",
  "description": "Generated TypeScript protocol types and runtime schemas for the Agent Communication Protocol",
  "keywords": [
    "agent-communication-protocol",
    "acp",
    "protobuf",
    "protojson",
    "events"
  ],
  "homepage": "https://github.com/frontal-labs/acp#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/acp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/acp.git",
    "directory": "packages/protocol"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/packages/protocol/src/index.d.ts",
      "import": "./dist/packages/protocol/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "ultracite fix src",
    "lint": "ultracite check src",
    "test": "vitest run --root ../.. packages/protocol/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@acp/core": "workspace:*",
    "@bufbuild/protobuf": "^2.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
