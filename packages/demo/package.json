{
  "name": "@acp/demo",
  "version": "0.1.0",
  "private": true,
  "description": "Reference Agent Communication Protocol demo application",
  "keywords": [
    "agent-communication-protocol",
    "acp",
    "demo",
    "example"
  ],
  "homepage": "https://github.com/frontal-labs/acp#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/acp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/acp.git",
    "directory": "packages/demo"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "node --import tsx/esm src/main.ts",
    "format": "ultracite fix src",
    "lint": "ultracite check src",
    "test": "vitest run --root ../.. packages/demo/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@acp/adapter": "workspace:*",
    "@acp/policy": "workspace:*",
    "@acp/testing": "workspace:*",
    "acp-sdk": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
