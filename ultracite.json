{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/.turbo",
      "!!**/.ocp-buf-cache",
      "!!**/coverage",
      "!!**/proto/gen",
      "!!**/target",
      "!!**/packages/protocol/tests/fixtures"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "trailingNewline": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "operatorLinebreak": "after",
      "bracketSpacing": true,
      "delimiterSpacing": false,
      "expand": "auto"
    }
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "examples/native-typescript/**",
        "examples/slack-typescript/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    }
  ]
}
