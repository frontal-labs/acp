{
  "name": "acp-cli",
  "version": "0.1.0",
  "description": "Command-line tools for validating and inspecting Agent Communication Protocol messages",
  "keywords": [
    "agent-communication-protocol",
    "acp",
    "cli",
    "protobuf",
    "validation"
  ],
  "homepage": "https://github.com/frontal-labs/acp#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/acp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/acp.git",
    "directory": "cli"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "acp": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node --import tsx/esm src/main.ts",
    "format": "ultracite fix src",
    "lint": "ultracite check src",
    "test": "vitest run --config vitest.config.ts --root .. cli/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@acp/protocol": "workspace:*",
    "@bufbuild/protobuf": "^2.2.5"
  },
  "devDependencies": {
    "@acp/testing": "workspace:*",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
