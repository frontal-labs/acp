{
  "name": "@frontal-labs/open-channel-ext-a2a",
  "version": "3.0.0",
  "description": "A2A-compatible source and sink bridge for the OpenChannel Protocol TypeScript SDK",
  "keywords": [
    "openchannel-protocol",
    "ocp",
    "a2a",
    "agents",
    "tasks"
  ],
  "homepage": "https://github.com/frontal-labs/open-channel#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/open-channel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/open-channel.git",
    "directory": "extensions/a2a"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "ultracite fix src tests",
    "lint": "ultracite check src tests",
    "test": "vitest run --root ../.. extensions/a2a/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.5",
    "@frontal-labs/open-channel": "workspace:*",
    "@frontal-labs/open-channel-adapter": "workspace:*",
    "@frontal-labs/open-channel-ext-shared": "workspace:*",
    "@frontal-labs/open-channel-protocol": "workspace:*"
  },
  "devDependencies": {
    "@frontal-labs/open-channel-testing": "workspace:*",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
