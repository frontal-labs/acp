{
  "name": "@acp/ext-postgres",
  "version": "0.1.0",
  "description": "PostgreSQL event store for the Agent Communication Protocol runtime",
  "keywords": [
    "agent-communication-protocol",
    "acp",
    "postgres",
    "event-store",
    "audit"
  ],
  "homepage": "https://github.com/frontal-labs/acp#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/acp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/acp.git",
    "directory": "extensions/postgres"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "ultracite fix src tests",
    "lint": "ultracite check src tests",
    "test": "vitest run --root ../.. extensions/postgres/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@acp/core": "workspace:*",
    "@acp/protocol": "workspace:*",
    "@acp/runtime": "workspace:*"
  },
  "devDependencies": {
    "@acp/testing": "workspace:*",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
